# DeepSeek (OpenAI 兼容)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 百度地图
BAIDU_MAP_AK=

# CORS 允许来源
ALLOW_ORIGINS=http://localhost:5276

# 图片文字识别（对话面板「图片提问」用；火山引擎方舟视觉模型）
VISION_API_KEY=
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-0-mini-260428

# 后台管理接口鉴权（知识库上传/删除/重建等）。留空 = 不校验（本地调试用）；
# 部署/评审时务必设置强随机值，前端管理面板请求会带 Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=
